{
  "name": "mapcode-rest-service-ts",
  "version": "2.11.3",
  "description": "TypeScript port of the Mapcode REST API service.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "fastify": "^5.12.7",
    "flatbush": "^4.6.2",
    "flatgeobuf": "^4.6.1",
    "mapcode-ts": "1.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
