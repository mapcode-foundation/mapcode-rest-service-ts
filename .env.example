# mapcode-rest-service-ts environment variables.

# MAPCODE_BORDERS_PATH (required) - Path to the `borders.fgb` file. 
MAPCODE_BORDERS_PATH=./data/borders.fgb

# PORT (8080) - TCP port to listen on.
PORT=8080

# VERSION - Version string returned by `/mapcode/version`.

# MAPCODE_DB_URL (unset) - Optional Postgres connection string. When unset, request recording is disabled and `/mapcode/replay` is not registered. Contains credentials — never logged. May start with "postgresql://".
MAPCODE_DB_URL=

# MAPCODE_REPLAY_TOKEN (unset) - Bearer token for `GET /mapcode/replay` and `GET /mapcode/replay/stats`. Required whenever `MAPCODE_DB_URL` is set, the service refuses to start without it (fail closed).
MAPCODE_REPLAY_TOKEN=

# MAPCODE_DB_CA_CERT (unset) - Optional Postgres certificate.
MAPCODE_DB_CA_CERT=
